<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ecommerce Project</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-gray-100">


<!-- Navbar -->
<nav class="bg-blue-600 text-white p-4">

    <div class="container mx-auto flex justify-between items-center">

        <!-- Logo -->
        <a href="/" class="text-2xl font-bold">
            🛒 MyShop
        </a>

        <!-- Menu -->
        <div class="space-x-4">

            <a href="/" class="hover:text-gray-200">
                Home
            </a>

            <a href="/about" class="hover:text-gray-200">
                About
            </a>

            <% if(user) { %>

                <a href="/dashboard" class="hover:text-gray-200">
                    Dashboard
                </a>
                <a href="/categories" class="hover:text-gray-200">
                   Categories
                </a>
                <a href="/products" class="hover:text-gray-200">
                    Products
                </a>

                <a href="/auth/logout" class="hover:text-gray-200">
                    Logout
                </a>

            <% } else { %>

                <a href="/auth/login" class="hover:text-gray-200">
                    Login
                </a>

                <a href="/cart">
                    Cart
                </a>

                <a href="/auth/register" class="hover:text-gray-200">
                    Register
                </a>

            <% } %>

        </div>

    </div>

</nav>


<!-- Container -->
<div class="container mx-auto mt-6 px-4">


    <!-- Success Message -->
    <% if(success_msg.length > 0) { %>

        <div class="bg-green-100 text-green-700 p-3 rounded mb-4">

            <%= success_msg %>

        </div>

    <% } %>


    <!-- Error Message -->
    <% if(error_msg.length > 0) { %>

        <div class="bg-red-100 text-red-700 p-3 rounded mb-4">

            <%= error_msg %>

        </div>

    <% } %>