<!DOCTYPE html>
<html>

<head>
    <title>Login</title>
</head>

<body>

    <h1>Login</h1>

    <!-- Success Message -->
    <% if(success_msg.length > 0) { %>

        <p style="color:green;">
            <%= success_msg %>
        </p>

    <% } %>

    <!-- Error Message -->
    <% if(error_msg.length > 0) { %>

        <p style="color:red;">
            <%= error_msg %>
        </p>

    <% } %>

    <form action="/auth/login" method="POST">

        <input
            type="email"
            name="email"
            placeholder="Email"
            required
        >

        <br><br>

        <input
            type="password"
            name="password"
            placeholder="Password"
            required
        >

        <br><br>

        <button type="submit">
            Login
        </button>

    </form>

</body>

</html>