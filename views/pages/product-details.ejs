<%- include('../partials/header') %>

<div class="bg-white rounded-lg shadow p-8">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
    <!-- Product Image -->
    <div>
      <img src="/uploads/<%= product.image %>" class="w-full rounded-lg" />
    </div>

    <!-- Product Info -->
    <div>
      <h1 class="text-4xl font-bold mb-4"><%= product.name %></h1>

      <p class="text-gray-500 mb-4">
        Category:
        <strong> <%= product.category ? product.category.name : '' %> </strong>
      </p>

      <p class="text-blue-600 text-3xl font-bold mb-6">₹<%= product.price %></p>

      <p class="text-gray-700 leading-7 mb-6"><%= product.description %></p>

      <a
        href="/cart/add/<%= product._id %>"
        class="bg-blue-600 text-white px-6 py-3 rounded"
      >
        Add To Cart
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
